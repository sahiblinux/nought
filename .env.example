# ──────────────────────────────────────────────────────────────
#  Nought — Environment Variables
#
#  Copy this file to .env and fill in your own values.
#  These are the ONLY secrets the app needs.
# ──────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────
# Get these from your Supabase dashboard → Settings → API
#
# Your project URL:
NEXT_PUBLIC_SUPABASE_URL=https://nulcaofuybdxzuhkrmee.supabase.co
#
# The "anon public" key (safe for frontend):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
#
# The "service_role" key (SECRET — only for API routes):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Frontend copies (Vite reads VITE_ prefixed vars at build time) ──
# Same values as above — Vite needs them with the VITE_ prefix
VITE_SUPABASE_URL=https://nulcaofuybdxzuhkrmee.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Email (optional — without this, OTPs show on-screen) ─────
# Get a key from resend.com (free tier: 100 emails/day)
RESEND_API_KEY=
MAIL_FROM=Nought <onboarding@yourdomain.com>

# ── Code runner (optional — defaults to public Judge0 CE) ────
JUDGE0_URL=https://ce.judge0.com
JUDGE0_KEY=

# ── Google sign-in (optional) ────────────────────────────────
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# ── Split deployment (GitHub Pages only) ─────────────────────
# If your frontend is on a different domain than your API,
# set this to the API's origin (no trailing slash).
# Leave EMPTY for same-origin deployments (Vercel, Cloudflare Pages).
VITE_API_BASE=
